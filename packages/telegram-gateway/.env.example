# Telegram bot token (required) — get from @BotFather
# Bun loads this automatically. DO NOT put it inline in your shell command.
TELEGRAM_BOT_TOKEN=

# Restrict to specific Telegram user IDs (comma-separated) or "*" for all
GATEWAY_ALLOWED_USERS=*

# Agent working directory (default: cwd)
# GATEWAY_AGENT_CWD=/path/to/project

# Session persistence directory (default: auto)
# GATEWAY_SESSION_DIR=

# Debug: "true", "1", "pi-gateway", or "pi-gateway:*"
# DEBUG=pi-gateway

# ── Email (optional) ──────────────────────────────────────────────────
# EMAIL_IMAP_HOST=imap.example.com
# EMAIL_IMAP_USER=user@example.com
# EMAIL_IMAP_PASS=password
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_USER=user@example.com
# EMAIL_SMTP_PASS=password
# EMAIL_ALLOWED_DOMAINS=*
